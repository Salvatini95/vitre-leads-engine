# Copiar para .env e preencher. O .env NUNCA vai para o repo.

# Django
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-longo
DJANGO_DEBUG=True

# Google Places API (New) — chave do console Google Cloud.
# Habilitar "Places API (New)" no projeto e restringir a chave por API.
GOOGLE_PLACES_API_KEY=

# Teto mensal de requisicoes a Places. Cada requisicao = 1 pagina = ate 20
# resultados. O sistema BLOQUEIA a captacao ao atingir este numero — e a
# trava que garante fatura zero dentro da franquia gratuita.
PLACES_FRANQUIA_MENSAL=1000

# --- Foursquare Places API — fonte ALTERNATIVA de contingencia --------------
# Existe porque o billing do Google Cloud esta bloqueado (chamado de suporte
# aberto). Google Places continua sendo a fonte default quando disponivel.
#
# Chave em https://foursquare.com/developers — cadastro sem cartao de credito.
# Free/sandbox tier: ate 10.000 chamadas Pro/mes, sem cobranca.
#
# ATENCAO a cobertura: a Foursquare mapeia pequeno negocio de bairro no Brasil
# bem pior que o Google. Tratar como fonte de teste, nao substituicao.
FOURSQUARE_API_KEY=

# Teto mensal de chamadas a Foursquare. Franquia SEPARADA da do Google — as
# duas nao compartilham contador.
FOURSQUARE_FRANQUIA_MENSAL=10000

# Host da API. Padrao = geracao atual (auth Bearer). Se a chave for da v3
# legada, trocar para https://api.foursquare.com/v3 — o cliente ajusta o
# estilo de autenticacao sozinho.
FOURSQUARE_API_BASE=https://places-api.foursquare.com

# Campos `rating` e `stats` sao PAGOS (consomem credito de API, nao a
# franquia de chamadas). Sem credito na conta, pedi-los devolve 429 e derruba
# a busca INTEIRA. Manter False para captar de graca — o custo e que prospect
# vindo da Foursquare fica sem nota e sem total de avaliacoes, e portanto sem
# a ordenacao que o Admin usa na fila de curadoria.
FOURSQUARE_CAMPOS_PRO=False

# Regiao padrao de captacao
CIDADE_PADRAO=Maringá
ESTADO_PADRAO=PR
